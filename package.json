{
  "name": "taxibaiamare.com",
  "version": "1.0.0",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "npm -w controlcenter run dev",
    "build": "npm -w packages/shared run build && npm -ws run build --if-present",
    "start": "npm -w controlcenter run start",
    "typecheck": "npm -ws run typecheck --if-present",
    "lint": "npm -ws run lint --if-present",
    "check:all": "npm run typecheck && npm run lint",
    "verify:prod": "npm run build && NODE_ENV=production npm start",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:api": "node api/dist/index.js",
    "dev:controlcenter": "npm -w controlcenter run dev",
    "sim:fleet": "tsx scripts/dev-simulate-fleet.ts",
    "sim:orders": "tsx scripts/dev-simulate-orders.ts",
    "hash:password": "tsx scripts/hash-password.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "tree": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/project-tree.ps1",
    "tree:control": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/project-tree.ps1 -Root controlcenter",
    "tree:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/project-tree.ps1 -Root api"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "private": true,
  "workspaces": [
    "controlcenter",
    "api",
    "user",
    "driver",
    "packages/*"
  ],
  "devDependencies": {
    "tsx": "^4.20.5",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "engines": {
    "node": "24.x"
  }
}
